# ══════════════════════════════════════════════════════════
# Velkor Platform — Environment Variables Reference
# Copy relevant sections to each Railway service.
# NEVER commit actual values. All vars marked [REQUIRED]
# must be set before deployment.
# ══════════════════════════════════════════════════════════

# ── STRAPI (apps/api) ────────────────────────────────────
# [REQUIRED] PostgreSQL connection
# On Railway: use the auto-provided ${{Postgres.DATABASE_URL}} reference variables.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=velkor_platform
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# [REQUIRED] Set to 'true' on Railway (PostgreSQL addon requires SSL)
DATABASE_SSL=false

# [REQUIRED] Cryptographic secrets — NEVER use placeholder values in production.
#
# Generate all five at once:
#   node scripts/generate-secrets.js
#
# Each value must be unique and cryptographically random.
# Rotating any of these secrets invalidates all existing sessions and tokens.
JWT_SECRET=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=

# [REQUIRED] Four comma-separated random keys for Koa session encryption.
# Format: base64key1,base64key2,base64key3,base64key4
# The generator script (above) produces the correct format.
APP_KEYS=

# [REQUIRED] Public URL of the Next.js frontend (for CORS whitelist).
# On Railway: include the canonical domain and Railway preview/origin host.
FRONTEND_URL=https://velkor.com.mx,https://www.velkor.com.mx,https://velkor-web-production.up.railway.app

# Strapi server
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# ── NEXT.JS (apps/web) ───────────────────────────────────
# [REQUIRED] Canonical public production URLs.
NEXT_PUBLIC_SITE_URL=https://velkor.com.mx
NEXT_PUBLIC_APP_URL=https://velkor.com.mx
NEXT_PUBLIC_SITE_DOMAIN=velkor.com.mx

# [REQUIRED] Private URL of Strapi — NOT exposed to the browser.
# Use Railway's internal network URL for same-project services.
STRAPI_URL=http://localhost:1337

# [REQUIRED IN PRODUCTION] Cloudflare Turnstile.
# Both vars must be set together. If both are unset, Turnstile is disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# [RECOMMENDED IN PRODUCTION] Assessment automation webhook.
# Secret signs payloads with HMAC-SHA256 in X-Velkor-Signature.
ASSESSMENT_WEBHOOK_URL=
ASSESSMENT_WEBHOOK_SECRET=

# [RECOMMENDED IN PRODUCTION] Post-assessment email delivery via Resend.
RESEND_API_KEY=

# [OPTIONAL] WhatsApp Business number in international format (no + or spaces)
# If not set, the WhatsApp button is hidden instead of showing a broken link.
NEXT_PUBLIC_WHATSAPP_NUMBER=521XXXXXXXXXX

# [OPTIONAL] Plausible Analytics domain — privacy-first, no cookies.
# If not set, analytics are disabled entirely. Get your domain from plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=velkor.com.mx

# [OPTIONAL] PostHog analytics. Leave blank to keep provider disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# [OPTIONAL] Calendly scheduling URL for the /contacto page.
# If not set, the "Agendar llamada" card shows "Disponible próximamente".
NEXT_PUBLIC_CALENDLY_URL=

NODE_ENV=development
